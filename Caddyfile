{
	order versions after metrics
	order audit after encode
	debug
}

:80 {
	tracing {
		span gateway
	}

	# Audit plugin configuration
	audit {
		topic_name local-audit
		organization_id local-org
		stack_id local-stack
		auth_issuer http://localhost/api/auth
		auth_internal_url http://localhost/api/auth

		# Kafka publisher
		publisher_kafka_broker redpanda:29092
		publisher_kafka_enabled false
		publisher_kafka_tls_enabled false
		publisher_kafka_sasl_enabled false

		# Nats publisher
		publisher_nats_enabled true
		publisher_nats_url nats://nats:4222
		publisher_nats_client_id gateway
	}

	# Ledger API reverse proxy
	handle_path /api/ledger* {
		reverse_proxy 127.0.0.1:3068
	}

	# Versions plugin endpoint
	handle /versions {
		versions {
			region "local"
			env "local"
			endpoints {
				ledger http://127.0.0.1:3068/_info http://127.0.0.1:3068/_healthcheck
			}
		}
	}

	# Catch-all for unhandled API routes
	handle /api/* {
		respond "Bad Gateway" 502
	}
}
